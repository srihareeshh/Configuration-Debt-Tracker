{
  "name": "configuration-debt-tracker",
  "displayName": "Configuration Debt Tracker",
  "description": "Intelligent Configuration Debt Analysis and Remediation System for Software Configuration Management",
  "version": "1.0.0",
  "publisher": "scm-engineering",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "configuration",
    "technical debt",
    "scm",
    "static analysis",
    "audit",
    "cleanup"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "config-debt-sidebar",
          "title": "Configuration Debt",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "config-debt-sidebar": [
        {
          "type": "webview",
          "id": "configDebt.sidebarView",
          "name": "Configuration Debt Tracker"
        }
      ]
    },
    "commands": [
      {
        "command": "configDebt.scanWorkspace",
        "title": "Scan Workspace",
        "category": "Configuration Debt",
        "icon": "$(refresh)"
      },
      {
        "command": "configDebt.openDashboard",
        "title": "Open Main Dashboard",
        "category": "Configuration Debt",
        "icon": "$(dashboard)"
      },
      {
        "command": "configDebt.showBacklog",
        "title": "Show Cleanup Backlog",
        "category": "Configuration Debt",
        "icon": "$(checklist)"
      },
      {
        "command": "configDebt.refreshAnalysis",
        "title": "Refresh Analysis",
        "category": "Configuration Debt",
        "icon": "$(sync)"
      },
      {
        "command": "configDebt.clearHistory",
        "title": "Clear Scan History",
        "category": "Configuration Debt",
        "icon": "$(trash)"
      },
      {
        "command": "configDebt.explainFinding",
        "title": "Explain Finding",
        "category": "Configuration Debt",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "configDebt.openAiAssistant",
        "title": "Open AI Assistant",
        "category": "Configuration Debt",
        "icon": "$(hubot)"
      },
      {
        "command": "configurationDebt.setGeminiApiKey",
        "title": "Set Gemini API Key",
        "category": "Configuration Debt",
        "icon": "$(key)"
      },
      {
        "command": "configurationDebt.removeGeminiApiKey",
        "title": "Remove Gemini API Key",
        "category": "Configuration Debt",
        "icon": "$(trash)"
      },
      {
        "command": "configurationDebt.testGeminiConnection",
        "title": "Test Gemini Connection",
        "category": "Configuration Debt",
        "icon": "$(plug)"
      },
      {
        "command": "configDebt.explainSelection",
        "title": "Explain Selection with AI",
        "category": "Configuration Debt",
        "icon": "$(search)"
      },
      {
        "command": "configDebt.askAboutCurrentFile",
        "title": "Ask About Current File",
        "category": "Configuration Debt",
        "icon": "$(file-code)"
      },
      {
        "command": "configDebt.summarizeRepository",
        "title": "Summarize Repository with AI",
        "category": "Configuration Debt",
        "icon": "$(book)"
      },
      {
        "command": "configDebt.assessImpact",
        "title": "Assess Removal Impact",
        "category": "Configuration Debt",
        "icon": "$(graph)"
      },
      {
        "command": "configDebt.testAiConnection",
        "title": "Test AI Connection",
        "category": "Configuration Debt",
        "icon": "$(plug)"
      },
      {
        "command": "configDebt.watchWorkspace",
        "title": "Watch Workspace",
        "category": "Configuration Debt",
        "icon": "$(eye)"
      },
      {
        "command": "configDebt.rebuildIndex",
        "title": "Rebuild Code Index",
        "category": "Configuration Debt",
        "icon": "$(database)"
      },
      {
        "command": "configDebt.showFindings",
        "title": "Show Findings",
        "category": "Configuration Debt",
        "icon": "$(list-unordered)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "configDebt.scanWorkspace",
          "when": "view == configDebt.sidebarView",
          "group": "navigation"
        },
        {
          "command": "configDebt.openDashboard",
          "when": "view == configDebt.sidebarView",
          "group": "navigation"
        },
        {
          "command": "configDebt.openAiAssistant",
          "when": "view == configDebt.sidebarView",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "configDebt.explainSelection",
          "when": "editorHasSelection",
          "group": "ConfigurationDebt"
        },
        {
          "command": "configDebt.askAboutCurrentFile",
          "group": "ConfigurationDebt"
        }
      ]
    },
    "configuration": {
      "title": "Configuration Debt Tracker",
      "properties": {
        "configDebt.aiProvider": {
          "type": "string",
          "enum": [
            "offline",
            "gemini",
            "local",
            "openai"
          ],
          "default": "gemini",
          "description": "Active AI intelligence provider. When Gemini is configured, it provides repository-grounded intelligence. 'offline' is 100% deterministic and private."
        },
        "configDebt.aiModel": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "Model identifier for Google Gemini (e.g. gemini-2.5-flash, gemini-3.7-flash) or local (e.g. llama3) providers."
        },
        "configDebt.aiEndpoint": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "description": "Endpoint URL for local or OpenAI-compatible LLM runtimes."
        },
        "configDebt.aiTimeout": {
          "type": "number",
          "default": 25000,
          "description": "Timeout in milliseconds for AI requests."
        },
        "configDebt.aiAllowCloudContext": {
          "type": "boolean",
          "default": true,
          "description": "Allow transmitting redacted repository code and context to the configured cloud AI provider (e.g. Google Gemini)."
        },
        "configDebt.staleAgeDaysThreshold": {
          "type": "number",
          "default": 90,
          "description": "Age threshold in days to flag configuration items as potentially stale."
        },
        "configDebt.enableWatchMode": {
          "type": "boolean",
          "default": false,
          "description": "Automatically watch workspace files and incrementally update configuration debt."
        },
        "configDebt.maxFileSize": {
          "type": "number",
          "default": 2097152,
          "description": "Maximum file size in bytes to analyze (default: 2MB)."
        },
        "configDebt.analysisConfidenceThreshold": {
          "type": "number",
          "default": 50,
          "description": "Minimum confidence percentage required to report a configuration reference."
        },
        "configDebt.enableGenericFallback": {
          "type": "boolean",
          "default": true,
          "description": "Enable Level 7 generic text matching when specialized language analyzers find no matches."
        },
        "configDebt.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/target/**",
            "**/vendor/**",
            "**/coverage/**",
            "**/.venv/**",
            "**/__pycache__/**"
          ],
          "description": "Glob patterns to exclude from configuration scanning and source code analysis."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "dev": "npm run watch",
    "pretest": "npm run compile",
    "test": "node ./dist/tests/runTests.js",
    "demo": "node ./dist/scripts/demonstrate.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "mocha": "^12.0.3",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "fast-xml-parser": "^5.11.2",
    "yaml": "^2.3.4"
  }
}
